# Modern Guideways — Environment Configuration Example
# Duplicate this file to .env.local for local development
# Or add these keys in Vercel Project Settings -> Environment Variables

# --------------------------------------------------------------------------
# Supabase Credentials (from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api)
# --------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# --------------------------------------------------------------------------
# Lead Notification Email (Optional - via Resend API: https://resend.com)
# --------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Modern Guideways <onboarding@resend.dev>
ENQUIRY_NOTIFY_EMAIL=modernguideways@gmail.com

# --------------------------------------------------------------------------
# Instant Lead Alerts Webhook (Optional - Telegram / Discord / Slack / Zapier)
# --------------------------------------------------------------------------
ENQUIRY_WEBHOOK_URL=
